# Keep the build context small and free of local state.
node_modules
.git
.husky
.next
.next-*
.build-stash
.vercel
coverage
out
*.tsbuildinfo
.DS_Store

# Local env files must never reach an image: NEXT_PUBLIC_* values in them
# would be baked into the client bundle.
.env*
!.env.example

# Not needed to build or run.
.vscode
.claude
Dockerfile
.dockerignore
docker-compose*.yml
